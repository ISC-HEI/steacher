{
  "name": "exam_project_frontend",
  "version": "1.0.0",
  "description": "Frontend dependencies for exam_project",
  "scripts": {
    "build:codemirror": "rollup --config rollup.codemirror.config.mjs",
    "build:mobile": "rollup --config rollup.mobile.config.mjs",
    "watch:codemirror": "rollup --config rollup.codemirror.config.mjs --watch",
    "watch:mobile": "rollup --config rollup.mobile.config.mjs --watch",
    "watch:ts": "tsc --watch",
    "watch": "concurrently \"npm run watch:ts\" \"npm run watch:codemirror\" \"npm run watch:mobile\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",

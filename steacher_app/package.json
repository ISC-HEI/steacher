  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/canvas-confetti": "^1.9.0",
    "concurrently": "^9.2.1",
    "rollup": "^4.44.2",
    "tslib": "^2.8.1",
    "typescript": "^5.4.5"
  }
}
